            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "payer": {
                      "type": "string",
                      "example": "9hSR6S7WPtxmTojgo6GG3k4yDPecgJY292j7xrsUGWBu"
                    },
                    "signature": {
                      "type": "string"
                    }
                  },
                  "required": [
