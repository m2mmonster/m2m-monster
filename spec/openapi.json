                    "type": "string",
                    "example": "9hSR6S7WPtxmTojgo6GG3k4yDPecgJY292j7xrsUGWBu"
                  },
                  "max_compute_unit_price": {
                    "type": "string",
                    "pattern": "^\\d+$",
                    "description": "Lower priority fee cap in micro-lamports/CU (at most 5,000,000)"
                  }
                },
                "required": [
                  "quote",
                  "payer"
                ]
              }
            }
