    "/v1/refunds/build": {
      "post": {
        "summary": "Build an unsigned refund from the payee back to the payer, linked to the receipt. No fee; the original fee is not returned.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "receipt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Receipt JWS"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^\\d{1,20}$",
                    "example": "10000000",
                    "description": "At most the original gross amount"
                  },
                  "max_compute_unit_price": {
                    "type": "string",
                    "pattern": "^\\d+$",
                    "description": "Lower priority fee cap in micro-lamports/CU (at most 5,000,000)"
                  }
                },
                "required": [
                  "receipt",
                  "amount"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unsigned refund for the payee to sign",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsignedTransaction"
