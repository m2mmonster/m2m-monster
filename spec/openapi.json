    "/v1/payments/verify": {
      "post": {
        "summary": "For the payee: verify a payer-signed transaction against its quote and simulate it, before submitting",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quote": {
