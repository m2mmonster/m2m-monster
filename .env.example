# Copy to .env and fill in. Never commit .env or key files.
# devnet | mainnet (mainnet only with the user's explicit permission)
SOLANA_NETWORK=
# Mainnet gate: must be true for SOLANA_NETWORK=mainnet (default false)
MAINNET_ENABLED=
SOLANA_RPC_URL=
# Base58 64-byte ed25519 secret key that signs quotes and receipts. Never holds funds.
SERVICE_KEY=
DATABASE_URL=
# Optional locally; required in production
REDIS_URL=
PUBLIC_BASE_URL=
# Optional: /v1 and /mcp base URL (defaults to PUBLIC_BASE_URL)
API_BASE_URL=
PORT=
TRUST_PROXY=
RATE_LIMIT_IP_PER_MINUTE=
RATE_LIMIT_PUBKEY_PER_MINUTE=
RATE_LIMIT_API_KEY_PER_MINUTE=
